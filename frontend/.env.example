# ─── LIFELINE-X Frontend Environment Variables ──────────────────────────────
# Copy this file to .env.local and fill in values as needed.
# DO NOT commit .env.local to version control.

# ─── Backend API URL ─────────────────────────────────────────────────────────
# In development, Vite proxies /api/* to localhost:8000 — leave this empty.
# In production (standalone frontend), set to your FastAPI server URL.
VITE_API_URL=

# ─── Map Tile Provider ───────────────────────────────────────────────────────
# Default: OpenStreetMap tiles (no key required).
# For production, consider a commercial provider (MapTiler, Mapbox, etc.)
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOUR_KEY

# ─── Demo / Real Mode ────────────────────────────────────────────────────────
# Set to "true" to force Demo Mode regardless of backend availability.
# Leave empty for automatic detection.
# VITE_FORCE_DEMO_MODE=true
